# Append desired settings to backend/.env. Never commit real API keys.
# Local traces, metrics and evaluations work without Weave.
WEAVE_ENABLED=false
WEAVE_PROJECT=your-team/notebook-rag
WANDB_API_KEY=
# Metadata-only export: no questions, document text or answer bodies.
# Account tier cannot be detected from an API key; unknown is deliberate.
GEMINI_BILLING_TIER=unknown
# Optional separate judge model. Omit to use the selected chat model.
RAG_JUDGE_MODEL=
EVAL_JUDGE_MODEL=
RAG_RETRIEVE_K=12
RAG_CONTEXT_CHARACTERS=24000
RAG_MAX_OUTPUT_TOKENS=4096
RAG_THINKING_LEVEL=
